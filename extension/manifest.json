{
  "manifest_version": 3,
  "name": "StreamBuddy Companion",
  "version": "0.1.2",
  "description": "Per-stream mute for StreamBuddy, including players inside cross-origin iframes.",
  "minimum_chrome_version": "119",
  "permissions": ["scripting", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StreamBuddy Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["media-control.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.streambuddy.cc/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
